# guess-celebrity-game case config, sourced by demo/run_case.sh.
# Bash 3.2 compatible.

CASE_AGENTS=(gamer-dave gamer-eve gamer-frank)
CASE_PROMPT_FILES=(gamer-dave.txt gamer-eve.txt gamer-frank.txt)

# How long to let the case run before collecting results, in seconds.
CASE_DURATION_SECONDS="${CASE_DURATION_SECONDS:-180}"

# How long to wait for all agents to register online before giving up.
CASE_STARTUP_TIMEOUT_SECONDS="${CASE_STARTUP_TIMEOUT_SECONDS:-30}"
